# Copy to .env.web for the local web app; keep DagsHub credentials in .env.
MODEL_DIR=models/champion
DECISION_THRESHOLD=0.5
DATABASE_URL=sqlite:///var/visionguard.sqlite3
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=16000000
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Karachi
WEB_WORKERS=1
WEB_THREADS=2
WEB_TIMEOUT=60
CUDA_VISIBLE_DEVICES=-1
